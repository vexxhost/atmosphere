diff --git a/nova/files/sunrise.css b/nova/files/sunrise.css
new file mode 100644
index 000000000..c452c8b84
--- /dev/null
+++ b/nova/files/sunrise.css
@@ -0,0 +1,51 @@
+:root {
+  color-scheme: dark;
+}
+
+html,
+body {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  padding: 0;
+  overflow: hidden;
+  background: #000;
+  color: #fff;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  font-size: 11px;
+}
+
+#status {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: #000;
+  color: rgb(255 255 255 / 60%);
+  font-weight: 500;
+  letter-spacing: 0;
+  pointer-events: none;
+  transition: opacity 200ms ease;
+}
+
+#status.hidden {
+  opacity: 0;
+}
+
+#screen {
+  width: 100%;
+  height: 100%;
+  background: #000;
+}
+
+/* noVNC sets an inline cursor on every frame. Keep a local cursor visible. */
+#screen,
+#screen canvas {
+  cursor: default !important;
+}
+
+#noVNC_control_bar_anchor,
+#noVNC_control_bar {
+  display: none !important;
+}
