      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "expr": "openstack_ironic_node",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Node lifecycle state",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "name": 0,
              "id": 1,
              "provision_state": 2,
              "power_state": 3,
              "maintenance": 4,
              "resource_class": 5,
              "console_enabled": 6
            }
          }
        }
      ],
      "type": "table"
    }
