# {{ ansible_managed }}

defaults {
    user_friendly_names {{ multipathd_user_friendly_names | bool | ternary('yes', 'no') }}
    find_multipaths {{ multipathd_find_multipaths }}
}

devices {
{% for array in multipathd_arrays or _multipathd_legacy_arrays %}
{% for device in multipathd_array_profiles[array].devices %}
    device {
        vendor {{ device.vendor | to_json }}
        product {{ device.product | to_json }}
{% for key, value in (device.settings | default({})).items() %}
        {{ key }} {{ value | to_json }}
{% endfor %}
    }
{% endfor %}
{% endfor %}
}

blacklist {
{% if multipathd_arrays | length > 0 %}
      device {
        vendor ".*"
        product ".*"
      }
{% endif %}
{% for wwid in multipathd_blacklist_wwids %}
      wwid {{ wwid | to_json }}
{% endfor %}
      devnode "^pxd[0-9]*"
      devnode "^pxd*"
      device {
        vendor "VMware"
        product "Virtual disk"
      }
}
{% if multipathd_arrays | length > 0 %}

blacklist_exceptions {
{% for array in multipathd_arrays %}
{% for device in multipathd_array_profiles[array].devices %}
    device {
        vendor {{ device.vendor | to_json }}
        product {{ device.product | to_json }}
    }
{% endfor %}
{% endfor %}
}
{% endif %}
